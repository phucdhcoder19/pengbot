# Địa chỉ backend NestJS. Chú ý có sẵn hậu tố /api — mọi lời gọi trong
# src/lib/api.ts đều là đường dẫn tương đối so với nó ("/me", "/documents"...).
VITE_API_URL="http://localhost:3000/api"

# Đặt true để chạy hoàn toàn bằng dữ liệu giả trong src/lib/mock-data.ts,
# không cần backend. Tiện khi dựng giao diện hoặc backend đang hỏng.
VITE_USE_MOCK="false"
