# ─────────────────────────── Hạ tầng ───────────────────────────
# Postgres PHẢI là image có pgvector (pgvector/pgvector:pg16), không phải postgres thường
DATABASE_URL="postgresql://dev:dev@localhost:5432/pengbot"
REDIS_URL="redis://localhost:6379"

# Origin của dashboard. Chỉ áp cho /api/* — /public/* luôn mở cho mọi domain
# vì widget chạy trên website của bên thứ ba.
CLIENT_URL="http://localhost:5173"

# ─────────────────────────── Bảo mật ───────────────────────────
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="doi-thanh-chuoi-ngau-nhien-dai"

# ─────────────────────────── AI ───────────────────────────
# Lấy tại https://aistudio.google.com/apikey
# Có thể dùng CÙNG một key cho cả hai. Tách riêng để sau đổi nhà cung cấp
# cho một trong hai mà không phải sửa code.
EMBEDDING_API_KEY="AIza..."
LLM_API_KEY="AIza..."

# Ghim phiên bản cụ thể thay vì alias -latest: alias hay quá tải và trả 503
LLM_MODEL="gemini-3.5-flash"

# ─────────────────────────── Tinh chỉnh RAG ───────────────────────────
# Cosine distance tối đa để coi một chunk là "liên quan". Xa hơn ngưỡng này
# thì trả "không có thông tin" mà KHÔNG gọi LLM.
# Số đo tham khảo trên dữ liệu thật: hỏi trúng chủ đề ~0.24, lạc chủ đề ~0.43.
# PHẢI đo lại trên tài liệu của bạn, đừng lấy nguyên con số này.
RAG_MAX_DISTANCE="0.40"

# Số chunk đưa vào prompt. Cao hơn = phủ rộng hơn nhưng tốn token và dễ nhiễu.
RAG_TOP_K="5"

# Hybrid search: mỗi nhánh (vector, từ khoá) lấy bao nhiêu ứng viên trước khi
# gộp bằng RRF và cắt còn RAG_TOP_K. Lấy rộng để chunk bị một nhánh xếp thấp
# vẫn có cơ hội được nhánh kia kéo lên. Không dưới RAG_TOP_K.
RAG_CANDIDATES="20"

# ─────────────────────────── Tuỳ chọn ───────────────────────────
# PORT="3000"
# Thư mục chứa loader.js + core.js của widget. Mặc định ../widget tính từ backend.
# WIDGET_DIR="/app/widget"

# ─────────────────────── Rate limit (/public/chat) ───────────────────────
# Trần mỗi phút cho TENANT nằm trong plan-limits.ts (theo gói FREE/PRO/...),
# cùng với quota số câu trả lời mỗi tháng. Hai số dưới đây áp cho từng khách
# và từng IP, không phụ thuộc gói.
# RATE_LIMIT_VISITOR_PER_MIN="8"
# RATE_LIMIT_IP_PER_MIN="30"
# Đặt "false" để tắt hoàn toàn (chỉ dùng khi chạy test tải nội bộ).
# RATE_LIMIT_ENABLED="true"

# Số tầng proxy đứng trước app (nginx = 1). CHƯA ĐẶT = không tin
# X-Forwarded-For, req.ip là IP kết nối trực tiếp. Đặt sai thành "true" thì ai
# cũng tự khai IP được và trần theo IP mất tác dụng.
# TRUST_PROXY="1"
